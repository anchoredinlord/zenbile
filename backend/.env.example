# ─────────────────────────────────────────────
# Zenbil Backend — Environment Variable Template
# Copy this file to .env and fill in real values
# This file IS safe to commit to Git
# ─────────────────────────────────────────────

APP_NAME=Zenbil
APP_ENV=development
DEBUG=True

DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/zenbil_db

SECRET_KEY=generate-with-python3-c-import-secrets-print-secrets-token-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

UPLOAD_DIR=uploads/products
MAX_UPLOAD_SIZE_MB=5
